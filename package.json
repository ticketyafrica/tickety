{
  "name": "tickety-africa",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "ts-node --project tsconfig.scripts.json prisma/seed.ts"
  },
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test:emails": "TS_NODE_PROJECT=tsconfig.scripts.json node --require ts-node/register --test tests/email*.test.ts",
    "emails:preview": "ts-node --project tsconfig.scripts.json scripts/preview-emails.ts",
    "emails:backfill": "ts-node --project tsconfig.scripts.json scripts/backfill-event-emails.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:clear": "ts-node --project tsconfig.scripts.json prisma/clear.ts",
    "test:payments": "TS_NODE_PROJECT=tsconfig.scripts.json node --require ts-node/register --test tests/payments.test.ts",
    "test:payouts": "TS_NODE_PROJECT=tsconfig.scripts.json node --require ts-node/register --test tests/payout*.test.ts",
    "test:admin": "TS_NODE_PROJECT=tsconfig.scripts.json node --require ts-node/register --test tests/admin.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.16.1",
    "@supabase/supabase-js": "^2.112.4",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.383.0",
    "next": "14.2.35",
    "next-auth": "^4.24.7",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.38",
    "prisma": "^5.16.1",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
