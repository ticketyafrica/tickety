# Local Postgres, e.g. via `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres`
# or a hosted instance (Supabase, Neon, Railway all offer a free Postgres tier).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tickety?schema=public"

# WhatsApp Cloud API webhook verification (see app/api/whatsapp/webhook/route.ts)
WHATSAPP_VERIFY_TOKEN="tickety-dev-verify-token"

# Email delivery: verify tickety.africa in Resend before sending.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL=""
ADMIN_NOTIFICATION_EMAILS=""
# Long random secret shared by Vercel Cron (or your external scheduler).
CRON_SECRET=""
