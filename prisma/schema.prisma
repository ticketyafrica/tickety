generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String  @id @default(cuid())
  name                   String
  email                  String  @unique
  passwordHash           String
  emailVerifiedAt        DateTime?
  role                   Role    @default(ORGANISER)
  paystackSubaccountCode String?
  paystackUsdSubaccountCode String?
  payoutPinHash          String?
  payoutPinFailedAttempts Int @default(0)
  payoutPinLockedUntil   DateTime?

  events Event[]

  eventStaff   EventStaff[]
  invitedStaff StaffInvitation[] @relation("StaffInvitationsSent")

  createdAt DateTime @default(now())
}

// Signup details stay here until the email address has been verified.
model SignupVerification {
  id           String   @id
  email        String   @unique
  name         String
  passwordHash String
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  sentAt       DateTime @default(now())

  @@index([expiresAt])
}

model Event {
  id            String      @id @default(cuid())
  slug          String      @unique
  currency      Currency    @default(NGN)
  title         String
  description   String
  state         String
  venue         String
  date          DateTime
  startTime     String
  endTime       String
  timezone      String      @default("Africa/Lagos")
  category      String
  status        EventStatus @default(live)
  featured      Boolean     @default(false)
  trending      Boolean     @default(false)
  coverGradient String
  coverImageUrl String?
  tags          String[]    @default([])
  refundPolicy  String?
  minAge        Int?

  organiserId String
  createdAt   DateTime @default(now())

  eventStaff       EventStaff[]
  staffInvitations StaffInvitation[]

  attendees       Attendee[]
  customQuestions CustomQuestion[]

  organiser         User               @relation(fields: [organiserId], references: [id])
  listingFeePayment ListingFeePayment?
  orders            Order[]
  ticketTypes       TicketType[]
  emailNotifications EmailNotification[]
  emailPreferences   EventEmailPreference[]

  @@index([state])
  @@index([category])
  @@index([organiserId])
  @@index([date])
}

model EventStaff {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
}

model StaffInvitation {
  id          String    @id @default(cuid())
  email       String
  eventId     String
  invitedById String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("StaffInvitationsSent", fields: [invitedById], references: [id])

  @@index([email])
  @@index([eventId])
}

model TicketType {
  id               String @id @default(cuid())
  name             String
  price            Decimal @db.Decimal(14, 2)
  quantityTotal    Int
  quantitySold     Int    @default(0)
  eventId          String
  quantityReserved Int    @default(0)

  attendees  Attendee[]
  orderItems OrderItem[]

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model CustomQuestion {
  id       String   @id @default(cuid())
  label    String
  type     String   @default("text")
  options  String[] @default([])
  required Boolean  @default(false)
  eventId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Order {
  id          String @id @default(cuid())
  reference   String @unique
  currency    Currency @default(NGN)
  paystackRef String @unique

  name  String
  email String
  phone String

  amount           Decimal @db.Decimal(14, 2)
  ticketAmount     Decimal @default(0) @db.Decimal(14, 2)
  serviceFee       Decimal @default(0) @db.Decimal(14, 2)
  organiserAmount  Decimal @default(0) @db.Decimal(14, 2)
  commissionAmount Decimal @default(0) @db.Decimal(14, 2)
  platformFee      Decimal @default(0) @db.Decimal(14, 2)
  paystackFee      Decimal? @db.Decimal(14, 2)

  status PaymentStatus @default(pending)

  expiresAt DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  eventId       String
  customAnswers Json?

  attendees Attendee[]
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@index([eventId])
  @@index([status])
  @@index([email])
}

model OrderItem {
  id           String @id @default(cuid())
  quantity     Int
  unitPrice    Decimal @db.Decimal(14, 2)
  orderId      String
  ticketTypeId String

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@unique([orderId, ticketTypeId])
  @@index([ticketTypeId])
}

model Attendee {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String
  ticketId      String        @unique
  amountPaid    Decimal @db.Decimal(14, 2)
  purchaseDate  DateTime      @default(now())
  paymentStatus PaymentStatus @default(pending)
  checkInStatus Boolean       @default(false)
  checkInTime   DateTime?
  ticketStatus  TicketStatus  @default(active)
  customAnswers Json?

  eventId      String
  ticketTypeId String
  orderId      String?

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  transaction Transaction?

  @@index([eventId])
  @@index([email])
  @@index([orderId])
}

model Transaction {
  id          String        @id @default(cuid())
  amount      Decimal @db.Decimal(14, 2)
  platformFee Decimal @db.Decimal(14, 2)
  status      PaymentStatus @default(pending)
  date        DateTime      @default(now())

  attendeeId String @unique

  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
}

model ListingFeePayment {
  paystackFee Decimal? @db.Decimal(14, 2)
  id          String        @id @default(cuid())
  eventId     String        @unique
  amount      Int
  paystackRef String        @unique
  status      PaymentStatus @default(pending)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// Transactional outbox: queued in the same transaction as ticket issuance.
model EmailNotification {
  id              String   @id @default(cuid())
  dedupeKey       String   @unique
  kind            String
  recipient       String
  eventId         String?
  orderId         String?
  userId          String?
  invitationId    String?
  preferenceId    String?
  context         Json?
  payload         Json?
  scheduledAt     DateTime @default(now())
  availableAt     DateTime @default(now())
  expiresAt       DateTime?
  status          String   @default("queued")
  attempts        Int      @default(0)
  lockToken       String?
  lockedUntil     DateTime?
  firstAttemptAt  DateTime?
  providerId      String?  @unique
  deliveryStatus  String?
  deliveryUpdatedAt DateTime?
  sentAt          DateTime?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([orderId])
  @@index([eventId, kind])
}

model EventEmailPreference {
  id             String   @id @default(cuid())
  eventId        String
  email          String
  verifiedAt     DateTime?
  verificationToken String @unique @default(uuid())
  verificationExpiresAt DateTime?
  confirmationRequestedAt DateTime?
  token          String   @unique @default(uuid())
  unsubscribedAt DateTime?
  createdAt      DateTime @default(now())
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
}

model EmailSuppression {
  email     String   @id
  reason    String
  createdAt DateTime @default(now())
}

model EmailWorkerLease {
  id          String   @id
  token       String?
  lockedUntil DateTime @default(now())
}

model EmailDeliveryEvent {
  id         String   @id
  providerId String
  status     String
  occurredAt DateTime

  @@index([providerId, occurredAt])
}

model EmailSubscriptionRateLimit {
  key       String   @id
  requests  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

enum Role {
  ORGANISER
  CHECKIN_STAFF
  ADMIN
}

enum EventStatus {
  live
  pending
  disabled
  archived
}

enum PaymentStatus {
  paid
  pending
  failed
}

enum TicketStatus {
  active
  used
  transferred
  cancelled
}


enum Currency {
  NGN
  USD
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorId    String?
  actorName  String?
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  dedupeKey  String?  @unique
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}
